{
  "name": "concorsofacile",
  "private": true,
  "description": "ConcorsoFacile — app di apprendimento con contesto e voce",
  "scripts": {
    "postinstall": "node scripts/versione.mjs",
    "predev": "node scripts/versione.mjs",
    "dev": "next dev",
